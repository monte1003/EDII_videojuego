[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/characters/character_model.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://assets/characters/plant/plant.glb" id="2_model"]
[ext_resource type="AnimationLibrary" path="res://assets/characters/plant/plant_idle.res" id="3_idle"]
[ext_resource type="AnimationLibrary" path="res://assets/characters/plant/plant_run.res" id="4_run"]
[ext_resource type="AnimationLibrary" path="res://assets/characters/plant/plant_jump.res" id="5_jump"]
[ext_resource type="AnimationLibrary" path="res://assets/characters/plant/plant_land.res" id="6_land"]

[node name="Plant" type="Node3D"]
script = ExtResource("1_script")
idle_animation = &"idle/Idle"
move_animation = &"run/Running"
jump_animation = &"jump/Jump"
land_animation = &"land/Land"

[node name="Model" parent="." instance=ExtResource("2_model")]

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("../Model")
libraries = {
&"idle": ExtResource("3_idle"),
&"run": ExtResource("4_run"),
&"jump": ExtResource("5_jump"),
&"land": ExtResource("6_land")
}
