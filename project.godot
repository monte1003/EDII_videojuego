; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EDII_juego"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
CustomCursor="*res://scripts/autoload/custom_cursor.gd"
ScreenFlow="*res://scripts/autoload/screen_flow.gd"
ColorFilter="*res://scripts/autoload/color_filter.gd"
UiSound="*res://scripts/autoload/ui_sound.gd"
GameSession="*res://scripts/autoload/game_session.gd"
ScreenFader="*res://scripts/autoload/screen_fader.gd"
InputDevice="*res://scripts/autoload/input_device.gd"
Rumble="*res://scripts/autoload/rumble.gd"

[display]

window/size/viewport_width=1200
window/size/viewport_height=780
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

