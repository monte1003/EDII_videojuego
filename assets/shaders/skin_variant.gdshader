shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

//Another colour of the same character: its own texture with the hue turned and a little more saturation, so two players with the
//same skin are told apart at a glance while the drawing stays the same
uniform sampler2D albedo_texture : source_color, filter_linear_mipmap, repeat_enable;
uniform vec4 albedo_color : source_color = vec4(1.0);
uniform float hue_shift = 0.0;
uniform float saturation = 1.15;
uniform float roughness = 0.6;
uniform float metallic = 0.0;

vec3 to_hsv(vec3 c) {
	vec4 k = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, k.wz), vec4(c.gb, k.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
}

vec3 to_rgb(vec3 c) {
	vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

void fragment() {
	vec4 base = texture(albedo_texture, UV) * albedo_color;
	vec3 hsv = to_hsv(base.rgb);
	hsv.x = fract(hsv.x + hue_shift);
	hsv.y = clamp(hsv.y * saturation, 0.0, 1.0);
	ALBEDO = to_rgb(hsv);
	ROUGHNESS = roughness;
	METALLIC = metallic;
}
